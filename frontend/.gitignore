# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto-generated by `next build`/`next dev` (Next.js 16's "agent rules"
# feature) at the repo root every run — not source, shouldn't be
# committed. Disable generation entirely via `agentRules: false` in
# next.config.ts if these become a recurring nuisance.
/AGENTS.md
/CLAUDE.md
