# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- AI provider (already configured — see lib/ai/humanize.ts) ---
GEMINI_API_KEY=

# --- Database (Phase 2 — see docs/PHASE_2_SETUP.md) ---
# Neon Postgres connection string, "Pooled connection" string from your
# Neon project dashboard. Looks like:
# postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Auth (Phase 2 — Better Auth) ---
# Any long random string — used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# The app's own URL. For local dev:
BETTER_AUTH_URL=http://localhost:3100

# --- Payments (Phase 3c — Razorpay, see docs/PAYMENTS_SETUP.md) ---
# From Razorpay Dashboard -> Settings -> API Keys. Use TEST mode keys
# until the live-mode checklist in docs/PAYMENTS_SETUP.md is complete.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard -> Settings -> Webhooks, after creating the
# webhook pointing at /api/payments/webhook. A separate secret from the
# API keys above — used only to verify webhook payload signatures.
RAZORPAY_WEBHOOK_SECRET=
